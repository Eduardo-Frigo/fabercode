# Copie este arquivo para:
# ~/Library/Application Support/Faber Code/.env
#
# O app empacotado aberto pelo Finder nao herda variaveis do terminal.
# Por isso, segredos de runtime devem ficar neste .env externo ao .app.

AI_PROVIDER=mock

# Conta/backend local do Faber Code
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fabercode
FABER_SESSION_SECRET=troque-por-um-segredo-longo-com-32-ou-mais-caracteres
FABER_APP_BASE_URL=http://127.0.0.1:37418
FABER_BACKEND_HOST=127.0.0.1
FABER_BACKEND_PORT=37418
FABER_POSTGRES_SSL=false
FABER_POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Login por email/senha local.
# Se quiser usar codigos dev por email, habilite apenas em ambiente local.
FABER_AUTH_DEV_CODES=false

# Escape hatches locais. Nao habilite em build distribuido.
FABER_TERMINAL_INHERIT_SENSITIVE_ENV=false
FABER_UPDATE_ALLOW_ADHOC_SIGNATURE=false
FABER_UPDATE_ALLOW_MISSING_CHECKSUM=false

# OAuth opcional
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:37418/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://127.0.0.1:37418/auth/github/callback

# IA remota opcional
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# SAMBANOVA_API_KEY=

# Pexels local opcional apenas para desenvolvimento/teste neste Mac.
# Usuario final nao precisa configurar chave Pexels propria.
# A chave compartilhada de plataforma nao deve ficar no .env do app desktop.
# PEXELS_API_KEY=

# Pexels de plataforma no release publico: apontar para a Edge Function remota.
# Exemplo: https://<project-ref>.supabase.co/functions/v1/pexels-media
# FABER_PLATFORM_MEDIA_ENDPOINT=
